{
  "name": "swagger-yaml-workbench-stan",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/d1-adapter": "1.11.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.3",
    "js-yaml": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.9.0",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.10",
    "miniflare": "^4.20250927.0",
    "wrangler": "^4.151.2"
  },
  "overrides": {
    "@auth/core": "$@auth/core",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "undici": "^7.29.1",
    "sharp": "^0.35.4"
  }
}
